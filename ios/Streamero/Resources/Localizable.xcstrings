{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "app.name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamero"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamero"
          }
        }
      }
    },
    "addServer.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to your media server"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoji se na svoj media server"
          }
        }
      }
    },
    "addServer.address": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server address"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa servera"
          }
        }
      }
    },
    "addServer.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. demo.streamero.net"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "npr. demo.streamero.net"
          }
        }
      }
    },
    "addServer.connect": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoji se"
          }
        }
      }
    },
    "addServer.error.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a valid address."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To ne izgleda kao valjana adresa."
          }
        }
      }
    },
    "addServer.error.starting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is starting. Try again in a few seconds."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Server se pokreće. Pokušaj ponovno za nekoliko sekundi."
          }
        }
      }
    },
    "addServer.error.notStreamero": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a Streamero server."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo nije Streamero server."
          }
        }
      }
    },
    "addServer.error.unreachable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the server."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nije dostupan."
          }
        }
      }
    },
    "server.connected %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected · version %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spojeno · verzija %@"
          }
        }
      }
    },
    "server.remove": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove server"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloni server"
          }
        }
      }
    },
    "login.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava"
          }
        }
      }
    },
    "login.username": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Korisničko ime"
          }
        }
      }
    },
    "login.password": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lozinka"
          }
        }
      }
    },
    "login.submit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavi se"
          }
        }
      }
    },
    "login.totp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code from the app"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod iz aplikacije"
          }
        }
      }
    },
    "login.totpHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 6-digit code from your authenticator app or a recovery code."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upišite 6-znamenkasti kod iz aplikacije za autentifikaciju ili kod za oporavak."
          }
        }
      }
    },
    "login.error.credentials": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wrong username or password."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogrešno korisničko ime ili lozinka."
          }
        }
      }
    },
    "login.error.locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many failed sign-ins. The account is locked for 15 minutes."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše neuspjelih prijava. Račun je zaključan 15 minuta."
          }
        }
      }
    },
    "login.error.totp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is not correct or was already used."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod nije ispravan ili je već iskorišten."
          }
        }
      }
    },
    "login.error.rateLimited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait a moment and try again."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Previše pokušaja. Pričekajte trenutak pa pokušajte ponovno."
          }
        }
      }
    },
    "login.error.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong. Please try again."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nešto nije u redu. Pokušajte ponovno."
          }
        }
      }
    },
    "quickConnect.use": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Quick Connect"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava s Quick Connectom"
          }
        }
      }
    },
    "quickConnect.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On a device where you are already signed in, open Settings → Quick Connect and enter this code:"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na uređaju na kojem ste već prijavljeni otvorite Postavke → Quick Connect i upišite ovaj kod:"
          }
        }
      }
    },
    "quickConnect.code": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
