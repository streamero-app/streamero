    },
    "backups.scanWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A library scan is running. The backup stays consistent, but titles still being added may be missing from it."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skeniranje biblioteke je u tijeku. Kopija ostaje dosljedna, ali naslovi koji se upravo dodaju možda neće biti u njoj."
          }
        }
      }
    },
