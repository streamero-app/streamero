            "value": "Sign-in asks for a code from your authenticator app. To turn it off, confirm your password."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava traži kod iz aplikacije za autentifikaciju. Za isključivanje potvrdite lozinku."
