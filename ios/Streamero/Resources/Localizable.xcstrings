    "backups.includeImagesHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded posters and backdrops can be fetched again, so they are left out by default. Including them makes backups much larger."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuzeti posteri i pozadine mogu se ponovno dohvatiti pa su prema zadanom izostavljeni. S njima su kopije puno veće."
          }
        }
      }
    },
    "backups.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup holds the whole database (users, libraries, watch history, settings) and the config folder. Media files are never included."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopija sadrži cijelu bazu (korisnike, biblioteke, povijest gledanja, postavke) i mapu s konfiguracijom. Medijske datoteke nikad nisu uključene."
          }
        }
      }
    },
    "backups.keepLast": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Čuvaj"
          }
        }
      }
    },
    "backups.keepLastHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many scheduled and manual backups to keep. Uploaded and pre-restore backups are only deleted by hand."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko zakazanih i ručnih kopija čuvati. Učitane kopije i one prije vraćanja brišu se samo ručno."
          }
        }
      }
    },
