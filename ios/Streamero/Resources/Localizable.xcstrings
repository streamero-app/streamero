    "twofa.recoveryText": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each code can be used once instead of an app code, e.g. if you lose your phone. They will not be shown again. Other devices were signed out."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki kod se može jednom upotrijebiti umjesto koda iz aplikacije, npr. ako izgubite mobitel. Više se neće prikazati. Ostali uređaji su odjavljeni."
          }
        }
      }
    },
    "twofa.recoveryTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save these recovery codes"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremite ove kodove za oporavak"
          }
        }
      }
    },
    "twofa.step1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code with your authenticator app, or on this phone tap the link. Then enter the 6-digit code it shows."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skenirajte QR kod aplikacijom za autentifikaciju ili na ovom mobitelu dodirnite poveznicu. Zatim upišite 6-znamenkasti kod koji aplikacija prikazuje."
          }
        }
      }
    },
