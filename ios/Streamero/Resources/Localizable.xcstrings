    "backups.restoreWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in the database is replaced with this backup: users, libraries, watch history and settings made after it are lost. A safety backup of the current state is written first, then the server restarts."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve u bazi zamjenjuje se ovom kopijom: korisnici, biblioteke, povijest gledanja i postavke nastale nakon nje bit će izgubljeni. Najprije se sprema sigurnosna kopija trenutnog stanja, zatim se server ponovno pokreće."
          }
        }
      }
    },
    "backups.running": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
