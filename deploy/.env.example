# Copy to deploy/.env and adjust. Never commit the real .env.
DB_PASSWORD=change-me
TZ=Europe/Zagreb
HTTP_PORT=8787

# Image (production): ghcr.io/<GH_OWNER>/streamero:<STREAMERO_VERSION>
GH_OWNER=streamero-app
STREAMERO_VERSION=latest

# Host paths
MEDIA_PATH=/mnt/media
CONFIG_PATH=./data/config
CACHE_PATH=./data/cache
DB_PATH=./data/postgres
RECORDINGS_PATH=./data/recordings

# GPU (compose.vaapi.yml / compose.qsv.yml): `getent group render | cut -d: -f3`
RENDER_GID=105

# Server
STREAMERO_SERVER_NAME=Streamero
STREAMERO_LOG_LEVEL=info
STREAMERO_AUTO_MIGRATE=true
# Fixed first-run setup code (optional; default: random, printed to the log on start)
# STREAMERO_SETUP_CODE=
